# 艮（Gèn）配置模板 —— 复制为 runtime/config.env 后填写
# 语音（阿里云 DashScope）：https://bailian.console.aliyun.com/ 申请
QWEN_AUDIO_REALTIME_API_KEY=sk-xxxx
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.1-realtime-flash
QWEN_AUDIO_REALTIME_VOICE=longanqian

# 主模型 / 后台执行（DeepSeek）：https://platform.deepseek.com/ 申请
# 可选：不填则「后台执行/主模型任务」不可用，语音对话不受影响
DEEPSEEK_API_KEY=sk-xxxx

# 服务器
PORT=3201
HOST=0.0.0.0
# 公网访问地址（媒体文件 URL、APK 上报回调用），本地试用可保持默认
GEN_PUBLIC_BASE_URL=http://127.0.0.1:3201
# 允许的浏览器来源（公网部署必填，逗号分隔）
QWEN_AUDIO_AGENT_ALLOWED_ORIGINS=https://your-domain.com

# 邮箱（可选，不启用则全部留空/保持 0）
GEN_EMAIL_ENABLED=0
GEN_EMAIL_ADDRESS=
GEN_EMAIL_IMAP_HOST=imap.163.com
GEN_EMAIL_IMAP_PORT=993
GEN_EMAIL_IMAP_USER=
GEN_EMAIL_IMAP_PASSWORD=
GEN_EMAIL_SMTP_HOST=smtp.163.com
GEN_EMAIL_SMTP_PORT=465
GEN_EMAIL_POLL_MINUTES=15
